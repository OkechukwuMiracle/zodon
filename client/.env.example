# Public build-time config for the frontend. Values here are embedded in the browser bundle.
# NEVER put API keys or secrets here.
# Development: leave unset — Vite proxies /api to http://localhost:3000.
# Production (e.g. Vercel): set to your deployed backend, including the /api suffix.
VITE_API_BASE_URL=https://your-zodon-api.onrender.com/api
