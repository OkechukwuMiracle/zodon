# Zodon server configuration.
# Copy this file to server/.env (same folder) and fill in your values. Never commit real keys.
# Frontend settings live in client/.env.example.

# Google Gemini API key from https://aistudio.google.com/apikey  (server-side only!)
GEMINI_API_KEY=
# Model id. "gemini-flash-latest" is Google's alias for the current multimodal Flash model.
GEMINI_MODEL=gemini-flash-latest
# Used only if the primary model returns HTTP 503 (temporary high demand). Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Timeout for a single AI call, in milliseconds
AI_TIMEOUT_MS=45000

PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the frontend URL)
CLIENT_ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=5
MAX_TEXT_CHARS=10000
RATE_LIMIT_ANALYZE_PER_10MIN=30
# Set to 1 when running behind a single reverse proxy (Render, Railway, etc.)
TRUST_PROXY=0

# Optional: Google Safe Browsing Lookup API key for URL reputation checks.
# When empty, Zodon performs structural URL analysis only.
GOOGLE_SAFE_BROWSING_API_KEY=

